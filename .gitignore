# Зависимости
node_modules/

# Билд на приложението (Vite). Наклонената черта отпред е важна:
# без нея правилото хващаше и supabase/dist/, където стои SQL пакетът.
/dist/

# Слепеният SQL файл се генерира с `npm run db:bundle`.
# Не се следи нарочно — копие в Git рано или късно изостава от миграциите,
# а точно това вече веднъж доведе до пропусната промяна при пускане.
/supabase/dist/

# Локални настройки и ключове
.env
.env.local
.env.*.local

# Supabase CLI
supabase/.temp/
supabase/.branches/

# Разни
.DS_Store
*.log
