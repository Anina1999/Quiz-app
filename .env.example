# Копирай този файл като .env.local и попълни стойностите от
# Supabase Dashboard -> Project Settings -> API
#
# ВАЖНО: тук влиза САМО anon (public) ключът. Той е безопасен за браузъра,
# защото достъпът се ограничава от RLS политиките в базата.
# service_role ключът НИКОГА не влиза в този файл и не се качва в Git.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
